# 忽略敏感信息和缓存
*.log
*.tmp
*.bak
.cache/
mcp-auth.json
.env
__pycache__/
*.pyc

# 忽略 node_modules
node_modules/

# 保留目录结构
!plugins/
!skills/
!commands/

# secrets
**/.env
!**/.env.example

# Python
__pycache__/
*.pyc



# 自动生成的网关模型注册表 / 更新检查（机器写入，不纳入版本管理）
opencode.json
opencode-skill-creator-update-check.json
# 客户端写进 skills/ 的运行时标记（非 skill，机器生成）
skills/.disable_to_model_invocation_migration.json
skills/.model_invocation_to_override_migration.json
skills/.system/

# 手工备份（如 opencode.json.bak-full70 —— *.bak 匹配不到带后缀的）
*.bak-*
# 外部 skill：只在本地可用，不纳入本仓版本控制
