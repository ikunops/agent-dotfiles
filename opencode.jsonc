{
    "$schema":  "https://opencode.ai/config.json",
    "plugin":  [
                   "openkilo",
                   "opencode-skill-creator"
               ],
    "shell":  "pwsh",
    "mcp":  {
                "infra-ops":  {
                                  "type":  "local",
                                  "command":  [
                                                  "infra-ops-mcp"
                                              ],
                                  "enabled":  true
                              },
                "composio":  {
                                 "type":  "remote",
                                 "url":  "https://connect.composio.dev/mcp",
                                 "enabled":  true
                             },
                "context7":  {
                                 "type":  "remote",
                                 "url":  "https://mcp.context7.com/mcp",
                                 "enabled":  true
                             },
                "open-computer-use":  {
                                          "type":  "local",
                                          "command":  [
                                                          "open-computer-use"
                                                      ],
                                          "enabled":  true
                                      },
                "xmind":  {
                              "type":  "local",
                              "command":  [
                                              "npx",
                                              "@41px/mcp-xmind"
                                          ],
                              "enabled":  true
                          },
                "cloudflare":  {
                                  "type":  "remote",
                                  "url":  "https://mcp.cloudflare.com/mcp",
                                  "enabled":  true,
                                  "oauth":  {}
                              },
                "cloudflare-docs":  {
                                        "type":  "remote",
                                        "url":  "https://docs.mcp.cloudflare.com/mcp",
                                        "enabled":  true
                                    },
                "cloudflare-bindings":  {
                                            "type":  "remote",
                                            "url":  "https://bindings.mcp.cloudflare.com/mcp",
                                            "enabled":  true,
                                            "oauth":  {}
                                        },
                "cloudflare-builds":  {
                                          "type":  "remote",
                                          "url":  "https://builds.mcp.cloudflare.com/mcp",
                                          "enabled":  true,
                                          "oauth":  {}
                                      },
                 "vmware-desktop":  {
                                        "type":  "local",
                                        "command":  [
                                                        "C:\\tools\\desktop-hypervisor-mcp\\desktop-hypervisor-mcp.exe"
                                                    ],
                                        "enabled":  true,
                                        "env":  {
                                                    "PATH":  "F:\\Program Files (x86)\\VMware\\VMware Workstation;"
                                                }
                                    },
                 "cloudflare-observability":  {
                                                 "type":  "remote",
                                                 "url":  "https://observability.mcp.cloudflare.com/mcp",
                                                 "enabled":  true,
                                                 "oauth":  {}
                                             }
            },
  "provider": {}
}
